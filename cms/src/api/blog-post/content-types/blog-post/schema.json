{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "Artykuły na blogu"
  },
  "options": {
    "draftAndPublish": true,
    "timestamps": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 150
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "maxLength": 300,
      "description": "Krótki opis artykułu (wyświetlany na liście)"
    },
    "content": {
      "type": "richtext",
      "required": true,
      "description": "Główna treść artykułu"
    },
    "publishDate": {
      "type": "datetime",
      "required": true,
      "description": "Data publikacji (widoczna dla użytkowników)"
    },
    "readTime": {
      "type": "integer",
      "required": true,
      "min": 1,
      "description": "Szacowany czas czytania w minutach"
    },
    "views": {
      "type": "integer",
      "default": 0,
      "description": "Liczba wyświetleń artykułu"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Artykuł wyróżniony (wyświetlany na górze)"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Główny obraz artykułu"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Dodatkowe zdjęcia w galerii"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "blog_posts"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "blog_posts"
    },
    "author": {
      "type": "component",
      "repeatable": false,
      "component": "blog.author",
      "required": true
    },
    "relatedPosts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-post.blog-post",
      "inversedBy": "relatedPosts"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "breadcrumbs": {
      "type": "json",
      "description": "Auto-generated breadcrumb structured data"
    },
    "faq": {
      "type": "component",
      "repeatable": true,
      "component": "blog.faq-item",
      "description": "FAQ items for FAQPage schema.org"
    }
  }
}
