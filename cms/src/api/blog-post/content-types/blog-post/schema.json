{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Posts",
    "description": "Artykuły na blogu"
  },
  "options": {
    "draftAndPublish": true,
    "timestamps": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 150
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "maxLength": 300,
      "description": "Krótki opis artykułu"
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "poradniki",
        "inspiracje", 
        "trendy",
        "narzedzia",
        "bezpieczenstwo",
        "ikea-tips",
        "cennik"
      ],
      "required": true
    },
    "author": {
      "type": "string",
      "default": "SkładaMy Team",
      "maxLength": 100
    },
    "readTime": {
      "type": "integer",
      "required": true,
      "min": 1,
      "description": "Szacowany czas czytania w minutach"
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "blog.tag"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Artykuł wyróżniony"
    },
    "views": {
      "type": "integer",
      "default": 0
    },
    "relatedPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post.blog-post"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
