# ============================================
# STRAPI CMS - Environment Configuration
# ============================================
# ⚠️  PRODUCTION DEPLOYMENT CHECKLIST:
# 1. Copy this file to .env and fill in all REQUIRED values
# 2. Generate NEW security keys: node scripts/generate-security-keys.js
# 3. Build admin panel: npm run build
# 4. Start server: npm start
#
# For local development:
# - Use: npm run develop (auto-reloads, no build needed)
# - NODE_ENV=development, PUBLIC_URL=http://localhost:1337

# --------------------------------------------
# ENVIRONMENT (REQUIRED)
# --------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# --------------------------------------------
# PUBLIC URLs (REQUIRED - NO FALLBACKS!)
# --------------------------------------------
# ⚠️  REQUIRED: Public URL where CMS is accessible
# Used for: admin panel, CORS validation, webhooks, email links
# Production example: PUBLIC_URL=https://cms.skladamy.com
# Development: PUBLIC_URL=http://localhost:1337
PUBLIC_URL=

# ⚠️  REQUIRED for production: CORS allowed origins (comma-separated)
# Development: set to frontend URL (e.g., http://localhost:3000)
# Production: MUST list all allowed frontend domains
# Example: CORS_ORIGIN=https://skladamy.com,https://www.skladamy.com
CORS_ORIGIN=

# --------------------------------------------
# SECURITY KEYS (REQUIRED - NO DEFAULTS!)
# --------------------------------------------
# ⚠️  CRITICAL: Generate unique keys for EACH environment!
# Run: npm run generate-keys
# NEVER commit real keys to git!
# NEVER reuse keys between environments!
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
SESSION_SECRET=

# --------------------------------------------
# DATABASE (REQUIRED)
# --------------------------------------------
# ⚠️  Production: Use mysql2 with ALL connection fields
# Development: Use better-sqlite3 for simplicity

# Database client: better-sqlite3 (dev) | mysql2 (prod)
# ⚠️  IMPORTANT: Comment out/remove the client you're NOT using!
DATABASE_CLIENT=better-sqlite3

# SQLite (development only) - REMOVE these lines in production:
DATABASE_FILENAME=.tmp/data.db

# MySQL (production) - UNCOMMENT and fill ALL these when using mysql2:
# DATABASE_CLIENT=mysql2
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=strapi_db
# DATABASE_USERNAME=strapi_user
# DATABASE_PASSWORD=your-password-here
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000

# Optional: SSL for production databases
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --------------------------------------------
# WEBHOOKS (REQUIRED)
# --------------------------------------------
# Auto-populate relations when triggering webhooks
WEBHOOKS_POPULATE_RELATIONS=false

# --------------------------------------------
# PROXY & NETWORKING (REQUIRED for production behind reverse proxy)
# --------------------------------------------
# ⚠️ CRITICAL: Set to true if behind reverse proxy (NGINX, Apache, Cloudflare, etc.)
# This allows Strapi to trust X-Forwarded-* headers for correct IP detection and HTTPS
# Production: TRUST_PROXY=true (almost always)
# Development (direct access): TRUST_PROXY=false
TRUST_PROXY=true

# --------------------------------------------
# FILE UPLOADS
# --------------------------------------------
# Maximum file size for uploads (in bytes)
# 50MB = 52428800, 100MB = 104857600
MAX_FILE_SIZE=52428800

# --------------------------------------------
# LOGGING & MONITORING
# --------------------------------------------
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# --------------------------------------------
# TELEMETRY
# --------------------------------------------
# Set to true to disable Strapi usage telemetry
STRAPI_TELEMETRY_DISABLED=true

# --------------------------------------------
# DEVELOPMENT/SCRIPTS (Optional)
# --------------------------------------------
# API Token for seeding scripts (development only!)
# Generate in: Strapi Admin → Settings → API Tokens → Create (Full Access)
# NEVER commit this to git or use in production frontend!
# STRAPI_ADMIN_TOKEN=
