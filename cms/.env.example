# CMS Environment Example
# Keys: APP_KEYS can be generated via npm run generate-keys

NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# Public URL of the CMS (used for admin URL and CORS)
PUBLIC_URL=https://cms.skladamy.com.pl

# CORS origins (comma separated) for production
CORS_ORIGIN=https://skladamy.pl,https://www.skladamy.pl,http://localhost:3000

# Trust proxy if behind Cloudflare/NGINX
TRUST_PROXY=true

# Admin
SERVE_ADMIN=true
ADMIN_PATH=/admin
