# ============================================
# STRAPI CMS - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# For local development, use: NODE_ENV=development

# --------------------------------------------
# ENVIRONMENT
# --------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# --------------------------------------------
# PUBLIC URLs
# --------------------------------------------
# Public URL where CMS is accessible (used for admin panel, CORS, webhooks)
PUBLIC_URL=https://cms.skladamy.com.pl

# Frontend URL (for CORS and API access)
FRONTEND_URL=https://skladamy.com.pl

# CORS allowed origins (comma-separated)
# Development: include http://localhost:3000
# Production: only production domains
CORS_ORIGIN=https://skladamy.com.pl,https://www.skladamy.com.pl

# --------------------------------------------
# SECURITY KEYS
# --------------------------------------------
# Generate secure random keys with: node scripts/generate-security-keys.js
# These MUST be different in production!
APP_KEYS=changeme1,changeme2,changeme3,changeme4
API_TOKEN_SALT=changeme-api-token-salt
ADMIN_JWT_SECRET=changeme-admin-jwt-secret
TRANSFER_TOKEN_SALT=changeme-transfer-token-salt
JWT_SECRET=changeme-jwt-secret
ENCRYPTION_KEY=changeme-encryption-key

# --------------------------------------------
# API TOKENS (Development/Scripts)
# --------------------------------------------
# Optional: Full Access token for seeding scripts (development only!)
# Generate in: Strapi Admin → Settings → API Tokens → Create (Full Access)
# NEVER commit this to git or use in production frontend
# STRAPI_ADMIN_TOKEN=your-full-access-token-here

# --------------------------------------------
# DATABASE
# --------------------------------------------
# Production: PostgreSQL or MySQL recommended
# Development: SQLite (default)
DATABASE_CLIENT=better-sqlite3
DATABASE_FILENAME=.tmp/data.db

# For PostgreSQL (production):
# DATABASE_CLIENT=postgres
# DATABASE_HOST=your-db-host
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=your-secure-password
# DATABASE_SSL=true

# --------------------------------------------
# ADMIN PANEL
# --------------------------------------------
SERVE_ADMIN=true
ADMIN_PATH=/admin

# Admin session configuration (in milliseconds)
# 7 days = 604800000, 30 days = 2592000000
ADMIN_SESSION_MAX_AGE=604800000

# --------------------------------------------
# PROXY & NETWORKING
# --------------------------------------------
# Set to true if behind Cloudflare, NGINX, or other reverse proxy
TRUST_PROXY=true

# --------------------------------------------
# FILE UPLOADS
# --------------------------------------------
# Maximum file size for uploads (in bytes)
# 50MB = 52428800, 100MB = 104857600
MAX_FILE_SIZE=52428800

# --------------------------------------------
# RATE LIMITING
# --------------------------------------------
# Prevent abuse (requests per time window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_INTERVAL=60000

# --------------------------------------------
# EMAIL (Optional - for notifications)
# --------------------------------------------
# EMAIL_PROVIDER=sendgrid
# EMAIL_PROVIDER_API_KEY=your-sendgrid-api-key
# EMAIL_DEFAULT_FROM=noreply@skladamy.com.pl
# EMAIL_DEFAULT_REPLY_TO=kontakt@skladamy.com.pl

# --------------------------------------------
# CLOUDFLARE (Optional - for R2 storage)
# --------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_ACCESS_KEY_ID=your-access-key
# CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-key
# CLOUDFLARE_BUCKET=strapi-uploads
# CLOUDFLARE_REGION=auto

# --------------------------------------------
# LOGGING & MONITORING
# --------------------------------------------
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# --------------------------------------------
# TELEMETRY
# --------------------------------------------
# Set to true to disable Strapi usage telemetry
STRAPI_TELEMETRY_DISABLED=true
