{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "prebuild": "node ./scripts/compile-configs.js",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=1536 node ./node_modules/@strapi/strapi/bin/strapi.js build",
    "prestart": "node ./scripts/compile-configs.js",
    "start": "node ./node_modules/@strapi/strapi/bin/strapi.js start",
    "develop": "cross-env NODE_ENV=development HOST=127.0.0.1 PORT=1337 PUBLIC_URL=http://localhost:1337 TRUST_PROXY=false node ./node_modules/@strapi/strapi/bin/strapi.js develop",
    "generate-keys": "node ./generate-keys.js"
  },
  "dependencies": {
    "@strapi/plugin-users-permissions": "^5.23.3",
    "@strapi/strapi": "^5.23.3",
    "better-sqlite3": "11.3.0",
    "cross-env": "^7.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "strapi-5-plugin-responsive-backend": "^0.0.4",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@types/node": "^20.19.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18 <=22",
    "npm": ">=8.0.0"
  },
  "packageManager": "npm@10.8.2"
}
