{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "node ./scripts/clean-dist.js && strapi build && tsc -p tsconfig.json",
    "start": "node server.js",
    "start:strapi": "strapi start",
    "start:custom": "node server.js",
    "develop": "strapi develop",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-keys": "node ./scripts/generate-security-keys.js",
    "backup": "node ./scripts/backup-database.js",
    "backup:help": "echo 'Usage: npm run backup - Creates a MySQL backup in cms/backups/ directory'"
  },
  "dependencies": {
    "@strapi/plugin-users-permissions": "^5.47.0",
    "@strapi/strapi": "^5.47.0",
    "@strapi/core": "^5.47.0",
    "@strapi/utils": "^5.47.0",
    "better-sqlite3": "^12.10.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "lodash": "^4.18.0",
    "mysql2": "^3.22.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "strapi-5-plugin-responsive-backend": "^0.0.4",
    "styled-components": "^6.4.2",
    "url-join": "^4.0.1",
    "vite": "^6.4.2",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@strapi/types": "^5.47.0",
    "@types/node": "^25.9.1",
    "axios": "^1.11.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "prismjs": "^1.30.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0"
  },
  "overrides": {
    "esbuild@<=0.24.2": ">=0.25.0",
    "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
    "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
    "lodash@<=4.17.23": ">=4.18.0",
    "vite@<=6.4.1": ">=6.4.2",
    "uuid@<11.1.1": ">=11.1.1",
    "qs@>=6.11.1 <=6.15.1": ">=6.15.2"
  },
  "engines": {
    "node": ">=18 <=22"
  }
}
