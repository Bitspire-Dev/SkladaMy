ADMIN_JWT_SECRET="VhecC6W4luQ6ojxKQnVIg+FCxL6NCBgFYaoobbMUEl7allcyKGL4d0Q6wj2Xu98Mt/4w4MklssVvpOwoIO7hRg=="
TRANSFER_TOKEN_SALT="XKOexRLLFP/APS/3JJFv/T0TC0UJqJmT9ZJ8XN39mP0DUzXIbapa23iHnqTfJrR6vykRfKg13l2G/QzeVlRhLQ=="
