SESSION_SECRET="GH5qUJ3EWbm0PoJttDbx38O8w+rkUMh1d8JHnZJ9c08="

# --------------------------------------------
# API TOKENS (Development/Scripts)
# --------------------------------------------
# Optional: Full Access token for seeding scripts (development only!)
# Generate in: Strapi Admin → Settings → API Tokens → Create (Full Access)
# NEVER commit this to git or use in production frontend
# STRAPI_ADMIN_TOKEN=your-full-access-token-here

# --------------------------------------------
# DATABASE (REQUIRED FOR MYSQL/POSTGRES)
# --------------------------------------------
# ⚠️  For production with MySQL/PostgreSQL: ALL fields are REQUIRED (no defaults!)
# For development with SQLite: DATABASE_CLIENT and DATABASE_FILENAME are sufficient

# Database type: better-sqlite3 (dev), mysql2 (production), postgres (production)
DATABASE_CLIENT=mysql2

# MySQL/PostgreSQL (for production) - ALL REQUIRED when using mysql2 or postgres:
DATABASE_HOST=h65.seohost.pl
DATABASE_PORT=3306
DATABASE_NAME=srv93337_skladamy
DATABASE_USERNAME=srv93337_skladamy
DATABASE_PASSWORD=123INKBSNZSTNMs!

# Optional: Use connection string instead of individual fields
# DATABASE_URL=mysql://user:password@host:port/database

# Optional: SSL configuration for production databases
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Database connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# --------------------------------------------
# WEBHOOKS
# --------------------------------------------
# Auto-populate relations when triggering webhooks
WEBHOOKS_POPULATE_RELATIONS=false

# --------------------------------------------
# ADMIN PANEL
# --------------------------------------------
# Admin panel path is configured in config/admin.ts (default: /admin)
# To change admin path, edit config/admin.ts directly - do NOT use env vars
SERVE_ADMIN=true

# --------------------------------------------
# PROXY & NETWORKING
# --------------------------------------------
# Set to true if behind Cloudflare, NGINX, or other reverse proxy
TRUST_PROXY=true

# --------------------------------------------
# FILE UPLOADS
# --------------------------------------------
# Maximum file size for uploads (in bytes)
# 50MB = 52428800, 100MB = 104857600
MAX_FILE_SIZE=52428800

# --------------------------------------------
# RATE LIMITING
# --------------------------------------------
# Prevent abuse (requests per time window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_INTERVAL=60000

# --------------------------------------------
# EMAIL (Optional - for notifications)
# --------------------------------------------
# EMAIL_PROVIDER=sendgrid
# EMAIL_PROVIDER_API_KEY=your-sendgrid-api-key
# EMAIL_DEFAULT_FROM=noreply@skladamy.com.pl
# EMAIL_DEFAULT_REPLY_TO=kontakt@skladamy.com.pl

# --------------------------------------------
# CLOUDFLARE (Optional - for R2 storage)
# --------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_ACCESS_KEY_ID=your-access-key
# CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-key
# CLOUDFLARE_BUCKET=strapi-uploads
# CLOUDFLARE_REGION=auto

# --------------------------------------------
# LOGGING & MONITORING
# --------------------------------------------
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# --------------------------------------------
# TELEMETRY
# --------------------------------------------
# Set to true to disable Strapi usage telemetry
STRAPI_TELEMETRY_DISABLED=true
