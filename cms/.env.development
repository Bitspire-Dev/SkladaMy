# ============================================
# STRAPI CMS - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# For local development, use: NODE_ENV=development

# --------------------------------------------
# ENVIRONMENT
# --------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=1337

# --------------------------------------------
# PUBLIC URLs (REQUIRED - NO FALLBACKS!)
# --------------------------------------------
# ⚠️  REQUIRED: Public URL where CMS is accessible (used for admin panel, CORS, webhooks)
# Example production: PUBLIC_URL=https://cms.skladamy.com.pl
# Example development: PUBLIC_URL=http://localhost:1337
PUBLIC_URL=http://localhost:1337

# ⚠️  REQUIRED for production: CORS allowed origins (comma-separated)
# Development: set to frontend URL to enable API calls
# Production: MUST list all allowed frontend domains
# Example: CORS_ORIGIN=https://skladamy.com.pl,https://www.skladamy.com.pl
CORS_ORIGIN=http://localhost:3000

# --------------------------------------------
# SECURITY KEYS (REQUIRED - NO DEFAULTS!)
# --------------------------------------------
# ⚠️  CRITICAL: Generate secure random keys with: node scripts/generate-security-keys.js
# These MUST be unique for each environment - NEVER use example values!
# NEVER commit real keys to git!
APP_KEYS="kdGGMHmCHDOJ8EmD7TExLeS4QrFghos6IeZCB2L3+zc=,kjpfsrKh3Y29ZVpKJbUl+Vs+9N4kXWMmwtSJ67WTIRo=,mpLkD41YtXNtEuUc5bB+hd4hJcxBAY6Ia33XUlsnlB0=,GidQ/OJKpoZHVZ7GsO8fHOV7BrNtM4Ze9H4tQESb/pg="
